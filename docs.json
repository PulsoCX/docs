{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pulso",
  "language": "en",
  "colors": {
    "primary": "#5b6a3d",
    "light": "#7e8e54",
    "dark": "#4a572f"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "family": "Montserrat"
  },
  "background": {
    "color": {
      "light": "#ffffff"
    }
  },
  "api": {
    "mdx": {
      "server": "https://api.pulso.cx",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Conversations",
            "pages": ["api-reference/endpoint/start-conversation"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Go to Pulso",
      "href": "https://pulso.cx"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/pulso-cx"
    }
  },
  "seo": {
    "metatags": {
      "title": "Pulso API documentation",
      "description": "Pulso is a conversational CX measurement platform. Trigger a conversation by phone, email, or WhatsApp from a single REST endpoint and let the AI agent run it end-to-end.",
      "og:title": "Pulso API documentation",
      "og:description": "Trigger conversational CX measurements across phone, email and WhatsApp from a single REST endpoint.",
      "og:site_name": "Pulso",
      "og:type": "website",
      "robots": "index, follow"
    }
  }
}
